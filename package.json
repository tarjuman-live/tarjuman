{
  "name": "livetranscribe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "node server.js",
    "dev:next": "next dev",
    "build": "convex deploy --cmd 'bunx convex codegen && next build'",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint",
    "test": "vitest run",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "//trustedDependencies": "bun blocks dependency install scripts by default (npm runs them). These four NEED theirs: @sentry/cli downloads the binary that uploads prod source maps, esbuild and unrs-resolver link their native binaries (vitest and eslint fail without them), and sharp builds Next's image optimizer. Without this list bun installs a tree that looks fine and then breaks at test/lint/build time.",
  "trustedDependencies": [
    "@sentry/cli",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
