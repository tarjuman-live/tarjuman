# ─────────────────────────────────────────────────────────────────────────────
# Tarjuman — local environment template. Copy to `.env.local` and fill in.
#
# These are the SERVER-SIDE vars the Next.js app reads (dev: `.env.local`;
# prod: Vercel project env). Convex-side secrets (auth, email) are set
# SEPARATELY with `npx convex env set …` — listed at the bottom.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Speechmatics — THE PRIMARY REALTIME STT ENGINE (see STT_PROVIDER in
# src/lib/constants.ts). Chosen over Deepgram in the 2026-08 Arabic bake-off:
# whole coherent sentences at ~1.00 confidence where nova-3 fragmented and
# dropped clauses. Without this key, recording fails unless STT_PROVIDER is
# flipped back to "deepgram". Key from portal.speechmatics.com.
#
# ⚠️  CONCURRENCY: the free tier allows only 2 CONCURRENT SESSIONS — i.e. two
# simultaneous users, app-wide. Pro raises it to 50. This must be upgraded
# before any real multi-user usage or the 3rd concurrent recorder gets a
# "quota_exceeded" error.
SPEECHMATICS_API_KEY=

# Anthropic — Claude (Haiku/Sonnet) translation + summaries. The product's core.
ANTHROPIC_API_KEY=

# Convex backend URL (from `npx convex dev`). Public — safe in the client bundle.
NEXT_PUBLIC_CONVEX_URL=

# ── Optional ─────────────────────────────────────────────────────────────────

# Deepgram — the FALLBACK STT engine. Only used when STT_PROVIDER is set to
# "deepgram" in src/lib/constants.ts (outage, concurrency cap, or a dialect
# Speechmatics handles worse), and by /dev/stt-compare, which always runs both
# engines regardless of that setting. In prod the key needs keys:write scope so
# the API route can mint short-lived session tokens. Leave blank and the app
# still records — just with no fallback available.
DEEPGRAM_API_KEY=

# Deepgram project id — skips one discovery round-trip per session when set.
DEEPGRAM_PROJECT_ID=

# Sunnah.com — hadith citation verification. WITHOUT this, hadith citations are
# marked "— unverified" (fail-safe) instead of pulling the authentic text +
# reference. Request a free key at sunnah.com. (Quran verification via
# quran.com / Muhsin Khan needs no key and always runs.)
SUNNAH_API_KEY=

# Convex deploy key — only needed when the machine's globally logged-in Convex
# account (~/.convex/config.json) doesn't have access to this project, which
# otherwise fails as "You don't have access to the selected project" on push.
# The CLI loads .env.local before reading this, and a deploy key TAKES
# PRECEDENCE over the logged-in token for this project only — so it does not
# disturb any other project you're logged into.
# Generate: dashboard.convex.dev → project → dev deployment → Settings → Deploy Key.
CONVEX_DEPLOY_KEY=

# App URL for absolute links / OpenGraph. Falls back sensibly if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry browser error tracking (client DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Google Search Console domain-verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set to 1 to expose /dev/stt-compare on a deployed build (it is on by default
# in dev). Use for a field comparison on a real phone in a real masjid; leave
# UNSET in production — each run opens two paid realtime sessions at once and
# can exhaust the Speechmatics concurrency cap for every other user.
NEXT_PUBLIC_STT_COMPARE=

# Shared secret for server-side usage logging (AI tokens/cost, STT credential
# mints) shown on /admin. Must equal the Convex env var of the same name.
# Leave empty to disable usage logging — nothing else depends on it.
USAGE_INGEST_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Convex-side secrets — NOT read here. Set with: npx convex env set KEY value
#   AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET      Google OAuth
#   JWT_PRIVATE_KEY / JWKS                   Convex Auth token signing
#   RESEND_API_KEY / RESEND_FROM             transactional email
#   LOOPS_API_KEY / LOOPS_PASSWORD_RESET_ID  password-reset email
#   SITE_URL                                 app URL used in email links
#   ADMIN_USER_IDS                           /admin allowlist (users._id, comma-separated)
#   ADMIN_ALERT_EMAIL                        operator alert recipient (convex/alerts.ts)
#   USAGE_INGEST_SECRET                      same value as above (convex/usage.ts)
# ─────────────────────────────────────────────────────────────────────────────
